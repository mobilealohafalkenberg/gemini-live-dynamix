# Google Gemini API Key (React App)
# Get your API key at: https://aistudio.google.com
# This is used by the React frontend to connect to Gemini Live API
# IMPORTANT: Must start with REACT_APP_ prefix for Create React App

REACT_APP_GEMINI_API_KEY=your-gemini-api-key-here

# Robot Bridge Endpoint (Optional)
# URL of the Python bridge server that controls the physical robot
# Default: http://localhost:8081
# Change this if running the bridge on a different host/port

REACT_APP_ROBOT_ENDPOINT=http://localhost:8081

# Note: After changing this file, restart the dev server (npm start)
# Environment variables are embedded at build time, not runtime
